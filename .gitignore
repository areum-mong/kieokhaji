node_modules/
mobile/react_native_app/.expo/
mobile/react_native_app/.expo-home/
mobile/react_native_app/npm-debug.log*
mobile/react_native_app/yarn-debug.log*
mobile/react_native_app/yarn-error.log*
mobile/native_android/.gradle/
mobile/native_android/build/
mobile/native_android/local.properties
mobile/native_android/.cxx/
mobile/native_android/app/build/
*.apk
*.aar
*.jar

