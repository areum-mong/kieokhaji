# ==========================================
# 기억하지 (KIEOKHAJI) 프로젝트 .gitignore
# ==========================================

# 1. Python runtime & Virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/

# 2. IDE / OS configuration files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 3. Environment Secrets
.env
.env.*
secrets.json

# 4. Large Datasets and Private Clinical Data (CRITICAL for Healthcare Security)
data/
# Exclude large demo videos
*.mp4
research/ClinicalDemogData_COFL.xlsx
*.csv
*.xlsx
*.xls
!MOCA/market_whitelist.txt

# 5. Large Model Weights (Except deployment model)
*.pth
*.pt
*.ckpt
*.h5
*.hdf5
*.keras
*.joblib
# Keep the final deployment model and metadata in git
!MOCA/models/gait_daily_clinical_3feat.joblib
!MOCA/models/gait_daily_clinical_3feat_metadata.json
!MOCA/models/waist_sensor_range_loss_calibration.json

